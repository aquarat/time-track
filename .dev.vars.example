# Copy to .dev.vars for local development.
#
# wrangler.jsonc holds the production Access values (placeholders in the public
# repository), and `wrangler dev` inherits them, so with no Zero Trust session in
# front of localhost the Worker would refuse every request. Blanking them and
# setting ALLOW_UNAUTHENTICATED turns the gate off locally. Never set
# ALLOW_UNAUTHENTICATED anywhere else: .dev.vars is gitignored and is never
# uploaded by `wrangler deploy`, which is what keeps it local.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ALLOW_UNAUTHENTICATED=true
