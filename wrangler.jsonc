{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "time-track",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",

  // Only serve from the custom domain, which sits behind Cloudflare Access.
  // Leaving workers.dev enabled would expose an un-Access'd hostname.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "time-track.example.com",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker so the Access check covers the SPA
    // shell too, not just /api/*. Scoping this to API routes would let the asset
    // worker serve HTML without ever consulting the gate. The Worker falls
    // through to env.ASSETS for anything it does not handle itself.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "time-track",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],

  "vars": {
    // Cloudflare Access enforcement (see README "Locking it down").
    //
    // ACCESS_AUD is the "Time Track" Access application's Audience tag. It pins
    // the Worker to that one application: without it, any valid token issued to
    // the same Zero Trust team — including from the other apps on this account —
    // would be accepted here.
    //
    // Neither value is a secret; both appear in the JWT the browser already
    // holds. EMPTY strings disable verification entirely, which is intended only
    // for `wrangler dev` — never deploy with them blank.
    "ACCESS_TEAM_DOMAIN": "yourteam.cloudflareaccess.com",
    "ACCESS_AUD": "CONFIGURE-ME"
  },

  "observability": {
    "enabled": true
  }
}
