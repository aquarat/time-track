{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "time-track",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",

  // The four CONFIGURE-ME values below are placeholders. Replace them by hand, or
  // run `bun run configure` with the matching environment variables set (see
  // README, "Deploying your own instance"). Deploying with them unchanged fails:
  // the route names a domain you do not own and the database does not exist.

  // Only serve from the custom domain, which sits behind Cloudflare Access.
  // Leaving workers.dev enabled would expose a hostname Access does not cover.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "CONFIGURE-ME.example.com",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker so the Access check covers the SPA
    // shell too, not just /api/*. Scoping this to API routes would let the asset
    // worker serve HTML without ever consulting the gate. The Worker falls
    // through to env.ASSETS for anything it does not handle itself.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "time-track",
      // From `bunx wrangler d1 create time-track`.
      "database_id": "CONFIGURE-ME-D1-DATABASE-ID",
      "migrations_dir": "./migrations"
    }
  ],

  "vars": {
    // Cloudflare Access enforcement (see README, "Cloudflare Access").
    //
    // ACCESS_AUD is your Access application's Audience tag. It pins the Worker to
    // that one application: without it, any valid token issued to the same Zero
    // Trust team, including for other applications, would be accepted here.
    //
    // Neither value is a secret; both appear in the JWT the browser already
    // holds. If either is empty the Worker refuses every request.
    "ACCESS_TEAM_DOMAIN": "CONFIGURE-ME.cloudflareaccess.com",
    "ACCESS_AUD": "CONFIGURE-ME-ACCESS-AUD"
  },

  "observability": {
    "enabled": true
  }
}
