{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "time-track",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",

  // Only serve from the custom domain, which sits behind Cloudflare Access.
  // Leaving workers.dev enabled would expose an un-Access'd hostname.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "time-track.example.com",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker so the Access check covers the SPA
    // shell too, not just /api/*. Scoping this to API routes would let the asset
    // worker serve HTML without ever consulting the gate. The Worker falls
    // through to env.ASSETS for anything it does not handle itself.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "time-track",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],

  "vars": {
    // Cloudflare Access enforcement (see README "Locking it down").
    //
    // Non-empty values switch the gate on. These placeholders can never match a
    // real assertion, so the deployed app denies every request until the Access
    // application exists and the real values are filled in — it fails closed,
    // which is the safe state to sit in while the Zero Trust side is set up.
    //
    // EMPTY strings disable verification entirely. That is intended only for
    // `wrangler dev`; never deploy with them blank.
    "ACCESS_TEAM_DOMAIN": "CONFIGURE-ME.cloudflareaccess.com",
    "ACCESS_AUD": "CONFIGURE-ME"
  },

  "observability": {
    "enabled": true
  }
}
